{
  "name": "MultiCatálogo Torres",
  "short_name": "Torres",
  "description": "Tienda cosmética con red de ventas multinivel. Catálogo y red consultables sin conexión.",
  "lang": "es",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#0a196f",
  "categories": ["shopping", "business", "lifestyle"],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://multicatalogo.labtorres.me/manifest.webmanifest"
    },
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest"
    }
  ],
  "icons": [
    { "src": "/pwa-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/pwa-icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/pwa-icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Tienda",
      "short_name": "Tienda",
      "url": "/tienda",
      "icons": [{ "src": "/pwa-icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Carrito",
      "short_name": "Carrito",
      "url": "/carrito",
      "icons": [{ "src": "/pwa-icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
