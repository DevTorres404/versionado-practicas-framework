# MultiCatálogo backend — environment template.
# Copy to backend/.env and adjust. The real .env is git-ignored.
# POSTGRES_* keys are shared by docker-compose.yml (interpolation)
# and config/db.go (connection pool), so keep the port consistent.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=multicatalogo
POSTGRES_PASSWORD=multicatalogo
POSTGRES_DB=multicatalogo
POSTGRES_SSLMODE=disable

# Redis (Fase 3: Cache-Aside)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
