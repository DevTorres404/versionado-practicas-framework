# ---------------------------------------------------------------------------
# Caddy termina TLS y hace proxy a nginx (que sirve los estáticos y /api).
#
# Por qué Caddy y no nginx: el service worker exige un ORIGEN SEGURO (HTTPS).
# nginx sirve HTTP plano dentro de la red de Docker; Caddy es el terminador
# TLS que publica en 80/443 y reenvía a nginx por la red interna.
#
# Variables de entorno (Caddy las sustituye al arrancar):
#   - APP_HOST    : host público de la app. Default `localhost`.
#                   Con un dominio real (app.ejemplo.com) Caddy emite el
#                   certificado de Let's Encrypt sin configuración extra.
#                   Con `localhost` usa su CA local: el navegador va a pedir
#                   que se confíe en el certificado (es lo esperado en
#                   desarrollo).
#   - ACME_EMAIL  : email de contacto para los avisos de expiración de
#                   Let's Encrypt. NO se declara un bloque `global { email }`
#                   acá a propósito: con la variable vacía Caddy NO arranca
#                   ("email is required" / error de configuración). Se
#                   define en el entorno del contenedor, no en este archivo.
#
# Puertos que hay que exponer en el host: 80 y 443 (TCP).
#
# Red: Caddy tiene que alcanzar el servicio `frontend` por su nombre de
#   red. Los puertos publicados en el compose son:
#     - frontend: host ${FRONTEND_PORT:-8080} -> contenedor 80 (nginx)
#     - backend:  host ${BACKEND_PORT:-3000}  -> contenedor 3000
#   Caddy no usa los puertos publicados: dentro de la red de compose el
#   frontend se alcanza en `frontend:80`.
#     docker run -d --name multicatalogo-caddy \
#       --restart unless-stopped \
#       --network multicatalogo_multicatalogo -p 80:80 -p 443:443 \
#       -e APP_HOST=app.ejemplo.com -e ACME_EMAIL=dev@ejemplo.com \
#       -v $PWD/Caddyfile:/etc/caddy/Caddyfile:ro \
#       -v multicatalogo_caddy_data:/data \
#       caddy:2-alpine
#
# El nombre de la red es `<proyecto>_<red>`: el proyecto y la red del compose
# se llaman `multicatalogo`, así que la red real es
# `multicatalogo_multicatalogo` (ver `docker network ls`).
# ---------------------------------------------------------------------------

{$APP_HOST:localhost} {
	encode zstd gzip

	# Defensa en profundidad: nginx ya sirve `sw.js` con `no-cache`, pero Caddy
	# no debe pisar ese header. Si el `sw.js` se cachea en el navegador, la
	# app queda clavada en una versión vieja y nunca se actualiza.
	header /sw.js Cache-Control "no-cache, no-store, must-revalidate"

	# nginx sirve los estáticos y hace proxy de `/api` al backend: el service
	# worker y el JWT siguen viviendo en un único origen.
	reverse_proxy frontend:80
}
